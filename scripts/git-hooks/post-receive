#!/usr/bin/env bash
# Install into a bare repo's hooks/ or a working repo's .git/hooks/.
# Git for Windows runs this with its bundled shell; the only external tool
# required is curl (bundled with Git for Windows). No jq needed.
set -euo pipefail

sink="${ANIMA_DEPLOY_HOOK_URL:-http://127.0.0.1:7414/hooks/git/generic}"
repo="${ANIMA_DEPLOY_REPO:-$(basename "$(pwd)")}"

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

while read -r oldrev newrev refname; do
  # Ignore branch deletion.
  if [ "$newrev" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  payload="$(printf '{"ref":"%s","before":"%s","after":"%s","repository":{"full_name":"%s"},"pusher":{"name":"local-hook"},"commits":[]}' \
    "$(json_escape "$refname")" \
    "$(json_escape "$oldrev")" \
    "$(json_escape "$newrev")" \
    "$(json_escape "$repo")")"

  args=(-fsS -X POST "$sink" -H "Content-Type: application/json" -d "$payload")
  if [ -n "${ANIMA_DEPLOY_SECRET:-}" ] && command -v openssl >/dev/null 2>&1; then
    signature="$(printf '%s' "$payload" | openssl dgst -sha256 -hmac "$ANIMA_DEPLOY_SECRET" -hex | awk '{print $NF}')"
    args+=(-H "X-Anima-Signature: $signature")
  fi

  curl "${args[@]}" >/dev/null
done
