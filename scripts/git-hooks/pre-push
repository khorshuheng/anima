#!/usr/bin/env bash
# Reject pushes whose commits add or modify SQLite/database files.
set -euo pipefail

zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    # First push: inspect the whole tree, including the root commit (diff-tree
    # without --root hides root-commit files).
    blocked=$(git ls-tree -r --name-only "$local_sha" |
      grep -Ei '\.(db|db3|db-wal|db-shm|db-journal|sqlite|sqlite3|sqlite-wal|sqlite-shm)$' || true)
  else
    blocked=$(git diff-tree --no-commit-id --name-only -r "$remote_sha..$local_sha" |
      grep -Ei '\.(db|db3|db-wal|db-shm|db-journal|sqlite|sqlite3|sqlite-wal|sqlite-shm)$' || true)
  fi
  if [ -n "$blocked" ]; then
    echo "refusing to push SQLite/database files on $local_ref:" >&2
    printf '  %s\n' $blocked >&2
    status=1
  fi
done

exit "$status"
