root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,proto,props,targets,csproj,sln,slnf,editorconfig}]
indent_size = 2

[*.cs]
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_style_readonly_field = true:warning

# Service code catches and logs at host boundaries; nullable analysis covers argument checks.
dotnet_diagnostic.CA1031.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA1812.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA5394.severity = none
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1056.severity = none
dotnet_diagnostic.CA2234.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1873.severity = none

dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0058.severity = none

# Namespaces are product-scoped (Anima.Knowledge, Anima.Automation) rather than
# mirroring project folders, so IDE0130's folder rule does not apply. Renaming them
# would change every public type's fully-qualified name.
dotnet_diagnostic.IDE0130.severity = none

[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1515.severity = none

[*.cs]
# SonarAnalyzer: keep the signal, don't fail the build on style or known false positives.
dotnet_diagnostic.S6966.severity = suggestion   # prefer async console/IO overloads
dotnet_diagnostic.S2325.severity = suggestion   # make static
dotnet_diagnostic.S1075.severity = none         # hardcoded default URLs/paths are intentional
dotnet_diagnostic.S2077.severity = none         # SQL is assembled from constants and parameters
dotnet_diagnostic.S8949.severity = suggestion   # background pumps use explicit lifetimes
dotnet_diagnostic.S3358.severity = suggestion   # nested ternaries
dotnet_diagnostic.S3267.severity = suggestion   # LINQ simplification
dotnet_diagnostic.S1751.severity = suggestion   # loop control style
dotnet_diagnostic.S4456.severity = suggestion   # iterator parameter validation
dotnet_diagnostic.S3400.severity = suggestion   # constant-returning methods
dotnet_diagnostic.S3241.severity = suggestion   # unused return values
dotnet_diagnostic.S2857.severity = suggestion   # SQL keyword casing
dotnet_diagnostic.S2365.severity = suggestion   # collection-copy properties
dotnet_diagnostic.S2094.severity = suggestion   # empty marker classes
dotnet_diagnostic.S1066.severity = suggestion   # merge nested if
dotnet_diagnostic.S8969.severity = suggestion   # xUnit NotNull is not a flow annotation
