{
  "schema_version": 1,
  "name": "core",
  "node_kinds": [
    { "id": 1, "name": "goal", "description": "An outcome a plan advances.", "traits": ["plannable"] },
    { "id": 2, "name": "task", "description": "A unit of work in a plan tree.", "traits": ["plannable"] },
    { "id": 3, "name": "change", "description": "A delivered code or config change." },
    { "id": 4, "name": "decision", "description": "A decision the work is justified by." },
    { "id": 5, "name": "bug", "description": "A defect." },
    { "id": 6, "name": "test", "description": "Evidence that an obligation holds." },
    { "id": 7, "name": "repo", "description": "A project repository; the anchor for a work tree." },
    { "id": 8, "name": "file", "description": "A file touched or owned by work." },
    { "id": 9, "name": "db_table", "description": "A database table." },
    { "id": 10, "name": "db_view", "description": "A database view." },
    { "id": 11, "name": "memory", "description": "A durable long-term memory entry." },
    { "id": 12, "name": "note", "description": "Free-form note." },
    { "id": 13, "name": "spec", "description": "A refined specification written by the analyst." },
    { "id": 14, "name": "question", "description": "A clarification question for the user." },
    { "id": 15, "name": "answer", "description": "An answer to a clarification question." },
    { "id": 16, "name": "workflow", "description": "A harness-driven workflow state record." },
    { "id": 17, "name": "phase", "description": "A workflow phase transition." },
    { "id": 18, "name": "result", "description": "An implementation, merge, review or verification outcome." },
    { "id": 19, "name": "finding", "description": "A defect or risk found during review." },
    { "id": 20, "name": "worktree", "description": "A harness-owned git worktree assignment." },
    { "id": 21, "name": "agent", "description": "An external agent identity." }
  ],
  "edge_types": [
    { "id": 1, "name": "part_of", "description": "Decomposition: task to goal or task.", "source_kinds": ["task"], "destination_kinds": ["goal", "task"], "acyclic": true, "traits": ["hierarchy"] },
    { "id": 2, "name": "depends_on", "description": "Ordering: the destination completes first.", "source_kinds": ["task"], "destination_kinds": ["task"], "acyclic": true },
    { "id": 3, "name": "affects", "description": "Predicted blast radius.", "source_kinds": ["task"], "destination_kinds": ["file", "db_table", "db_view"] },
    { "id": 4, "name": "implements", "description": "A change delivers a task.", "source_kinds": ["change"], "destination_kinds": ["task"], "resolves": true },
    { "id": 5, "name": "fixes", "description": "A change resolves a defect.", "source_kinds": ["change"], "destination_kinds": ["bug"], "resolves": true },
    { "id": 6, "name": "modifies", "description": "Actual touched set.", "source_kinds": ["change"], "destination_kinds": ["file", "db_table", "db_view"] },
    { "id": 7, "name": "justified_by", "description": "The reasoning a change answers to.", "source_kinds": ["change"], "destination_kinds": ["decision"] },
    { "id": 8, "name": "contains", "description": "Physical containment.", "source_kinds": ["repo"], "destination_kinds": ["file"] },
    { "id": 9, "name": "belongs_to", "description": "The project a goal advances.", "source_kinds": ["goal"], "destination_kinds": ["repo"], "single_outgoing": true, "traits": ["anchor"] },
    { "id": 10, "name": "verifies", "description": "Evidence that an obligation holds.", "source_kinds": ["test"], "destination_kinds": ["goal", "task"] },
    { "id": 11, "name": "reveals", "description": "A test surfaced a defect.", "source_kinds": ["test"], "destination_kinds": ["bug"] },
    { "id": 12, "name": "mentions", "description": "A memory references a node.", "source_kinds": ["memory", "note"], "destination_kinds": [] },
    { "id": 13, "name": "related_to", "description": "Unconstrained association.", "source_kinds": [], "destination_kinds": [] },
    { "id": 14, "name": "derived_from", "description": "Derived from another node.", "source_kinds": [], "destination_kinds": [] },
    { "id": 15, "name": "tracks", "description": "A workflow tracks its goal.", "source_kinds": ["workflow"], "destination_kinds": ["goal"], "single_outgoing": true },
    { "id": 16, "name": "specifies", "description": "A spec describes a workflow or goal.", "source_kinds": ["spec"], "destination_kinds": ["workflow", "goal"] },
    { "id": 17, "name": "asks", "description": "A question belongs to a workflow.", "source_kinds": ["question"], "destination_kinds": ["workflow"], "single_outgoing": true },
    { "id": 18, "name": "answers", "description": "An answer resolves a question.", "source_kinds": ["answer"], "destination_kinds": ["question"], "resolves": true, "single_outgoing": true },
    { "id": 19, "name": "phase_of", "description": "A phase belongs to a workflow.", "source_kinds": ["phase"], "destination_kinds": ["workflow"], "single_outgoing": true },
    { "id": 20, "name": "precedes", "description": "Phase ordering.", "source_kinds": ["phase"], "destination_kinds": ["phase"], "acyclic": true },
    { "id": 21, "name": "reviews", "description": "A result reviews a workflow, spec or change.", "source_kinds": ["result"], "destination_kinds": ["workflow", "spec", "change"] },
    { "id": 22, "name": "found_in", "description": "A finding was found in a result.", "source_kinds": ["finding"], "destination_kinds": ["result"] },
    { "id": 23, "name": "assigned_to", "description": "A worktree is assigned to an external agent.", "source_kinds": ["worktree"], "destination_kinds": ["agent"] },
    { "id": 24, "name": "worktree_of", "description": "A worktree serves a workflow.", "source_kinds": ["worktree"], "destination_kinds": ["workflow"], "single_outgoing": true },
    { "id": 25, "name": "result_of", "description": "A result belongs to a workflow.", "source_kinds": ["result"], "destination_kinds": ["workflow"], "single_outgoing": true },
    { "id": 26, "name": "implements_spec", "description": "A result implements a spec.", "source_kinds": ["result"], "destination_kinds": ["spec"] },
    { "id": 27, "name": "supersedes", "description": "A newer spec replaces an older one.", "source_kinds": ["spec"], "destination_kinds": ["spec"], "single_outgoing": true, "acyclic": true }
  ]
}
